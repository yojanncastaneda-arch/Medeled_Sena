{
  "info": {
    "name": "Medeled - API Autenticación (AA5-EV02)",
    "description": "Pruebas del servicio web de registro e inicio de sesión de Medeled.\n\nRequisitos: servidor encendido (mvn spring-boot:run) y tabla usuario creada (base.sql).\nEjecute la colección completa con \"Run collection\": cada corrida usa un usuario nuevo ({{usuarioPrueba}}).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuarioPrueba",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Registro",
      "item": [
        {
          "name": "1. Registro exitoso",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"usuarioPrueba\", \"prueba_\" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "pm.test(\"Mensaje: Usuario registrado correctamente\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Usuario registrado correctamente\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Registra un usuario nuevo. El nombre se genera con la fecha para que la prueba se pueda repetir.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"contrasena\": \"Clave2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Registro de usuario repetido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"exito = false\", () => pm.expect(pm.response.json().exito).to.eql(false));",
                  "pm.test(\"Mensaje indica que ya existe\", () => pm.expect(pm.response.json().mensaje).to.include(\"ya está registrado\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "El mismo usuario no se puede registrar dos veces.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"contrasena\": \"Clave2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "3. Registro con campos vacíos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Mensaje: Datos inválidos\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Datos inválidos\"));",
                  "pm.test(\"Incluye el error: El usuario es obligatorio\", () => pm.expect(pm.response.json().errores).to.include(\"El usuario es obligatorio\"));",
                  "pm.test(\"Incluye el error: La contraseña es obligatoria\", () => pm.expect(pm.response.json().errores).to.include(\"La contraseña es obligatoria\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Validación: usuario y contraseña son obligatorios.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"\",\n  \"contrasena\": \"\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "4. Registro con contraseña débil",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Incluye el error: La contraseña debe tener al menos una letra y un número\", () => pm.expect(pm.response.json().errores).to.include(\"La contraseña debe tener al menos una letra y un número\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Validación: la contraseña debe tener mínimo 8 caracteres, una letra y un número.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"usuario.debil\",\n  \"contrasena\": \"sololetras\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "5. Registro con usuario inválido",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Incluye el error: El usuario debe tener entre 4 y 30 caracteres\", () => pm.expect(pm.response.json().errores).to.include(\"El usuario debe tener entre 4 y 30 caracteres\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Validación: el usuario debe tener entre 4 y 30 caracteres (letras, números, punto o guion bajo).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"ab\",\n  \"contrasena\": \"Clave2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "6. Registro con JSON mal formado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Mensaje: El cuerpo de la petición debe ser un JSON válido\", () => pm.expect(pm.response.json().mensaje).to.eql(\"El cuerpo de la petición debe ser un JSON válido\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/registro",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "registro"
              ]
            },
            "description": "Validación: el cuerpo debe ser JSON.",
            "body": {
              "mode": "raw",
              "raw": "{ esto no es json",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Inicio de sesión",
      "item": [
        {
          "name": "7. Login correcto",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"exito = true\", () => pm.expect(pm.response.json().exito).to.eql(true));",
                  "pm.test(\"Mensaje: Autenticación satisfactoria\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Autenticación satisfactoria\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Usuario y contraseña correctos.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"contrasena\": \"Clave2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "8. Login sin distinguir mayúsculas",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"usuarioMayusculas\", pm.collectionVariables.get(\"usuarioPrueba\").toUpperCase());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Mensaje: Autenticación satisfactoria\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Autenticación satisfactoria\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "El nombre de usuario no distingue mayúsculas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioMayusculas}}\",\n  \"contrasena\": \"Clave2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "9. Login con contraseña incorrecta",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"exito = false\", () => pm.expect(pm.response.json().exito).to.eql(false));",
                  "pm.test(\"Mensaje: Error en la autenticación: usuario o contraseña incorrectos\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Error en la autenticación: usuario o contraseña incorrectos\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Contraseña equivocada: error en la autenticación.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\",\n  \"contrasena\": \"OtraClave99\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "10. Login con usuario inexistente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Mensaje: Error en la autenticación: usuario o contraseña incorrectos\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Error en la autenticación: usuario o contraseña incorrectos\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Usuario no registrado: mismo mensaje que con contraseña errada, para no revelar qué usuarios existen.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"no.existe.nunca\",\n  \"contrasena\": \"Clave2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "11. Login sin contraseña",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Incluye el error: La contraseña es obligatoria\", () => pm.expect(pm.response.json().errores).to.include(\"La contraseña es obligatoria\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Validación: la contraseña es obligatoria.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": \"{{usuarioPrueba}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
