{
  "info": {
    "name": "Medeled - API del Proyecto: Clientes y Ventas (AA5-EV04)",
    "description": "Pruebas de la API REST del proyecto Medeled (clientes y ventas).\n\nRequisitos: servidor encendido (mvn spring-boot:run) y base de datos creada con base.sql.\nEjecute la colección completa EN ORDEN con \"Run collection\": las pruebas crean un cliente y una venta, los consultan, actualizan y al final los eliminan, dejando la base como estaba.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "idCliente",
      "value": ""
    },
    {
      "key": "idVenta",
      "value": ""
    },
    {
      "key": "hoy",
      "value": ""
    },
    {
      "key": "manana",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Clientes",
      "item": [
        {
          "name": "1. Crear cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const hoy = new Date();",
                  "const f = (d) => d.getFullYear() + \"-\" + String(d.getMonth() + 1).padStart(2, \"0\") + \"-\" + String(d.getDate()).padStart(2, \"0\");",
                  "pm.collectionVariables.set(\"hoy\", f(hoy));",
                  "pm.collectionVariables.set(\"manana\", f(new Date(hoy.getTime() + 86400000)));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Responde en menos de 2 segundos\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const c = pm.response.json();",
                  "pm.test(\"Devuelve el id generado\", () => pm.expect(c.idCliente).to.be.a(\"number\").and.above(0));",
                  "pm.test(\"Encabezado Location apunta al cliente\", () => pm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/clientes/\" + c.idCliente));",
                  "pm.test(\"estado = pendiente\", () => pm.expect(pm.response.json().estado).to.eql(\"pendiente\"));",
                  "pm.collectionVariables.set(\"idCliente\", c.idCliente);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/clientes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "clientes"
              ]
            },
            "description": "Crea un cliente y guarda su id en la variable {{idCliente}} para las siguientes pruebas.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Cliente Prueba Postman\",\n  \"producto\": \"Panel solar 450W\",\n  \"fechaCompra\": \"{{hoy}}\",\n  \"estado\": \"pendiente\",\n  \"observaciones\": \"Reclamo por bajo rendimiento\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "2. Crear cliente con datos inválidos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Código de estado 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"mensaje = Datos inválidos\", () => pm.expect(pm.response.json().mensaje).to.eql(\"Datos inválidos\"));",
                  "pm.test(\"Incluye el error: El nombre es obligatorio\", () => pm.expect(pm.response.json().errores).to.include(\"El nombre es obligatorio\"));",
                  "pm.test(\"Incluye el error: La fecha de compra no puede ser futura\", () => pm.expect(pm.response.json().errores).to.include(\"La fecha de compra no puede ser futura\"));",
                  "pm.test(\"Incluye el error: El estado debe ser: pendiente, en_proceso o resuelto\", () => pm.expect(pm.response.json().errores).to.include(\"El estado debe ser: pendiente, en_proceso o resuelto\"));"
                ]
              }
            }
          ],
